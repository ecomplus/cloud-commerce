---
import { getBuiltPictureOrOriginal } from './get-built-picture';
import { getOriginalImageSize } from './get-original-image-size';
import { type PictureProps, useSSRPicture } from './use-ssr-picture';

export type Props = PictureProps;

const {
  sizes,
  media,
  sources,
  pictureAttrs,
  imgAttrs,
} = await useSSRPicture({
  ...Astro.props,
  tryImageSize: getOriginalImageSize,
  getPicture: getBuiltPictureOrOriginal,
  assetsPrefix: Astro.locals.assetsPrefix,
});
---

<picture {...pictureAttrs}>
  {sources.map((attrs) => <source {...attrs} {sizes} {media} />)}
  {imgAttrs && <img {...imgAttrs} />}
</picture>
